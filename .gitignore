# Real saves are never committed, but the sample and the test fixtures are.
*.hoi4
!src/save games/*.hoi4
!tests/data/*.hoi4

*.exe
*.zip
__pycache__/
/dist/
/build/
hoi4-presence*/
.venv/

# Written next to the executable, so running an entry point from source drops
# one in src/entrypoints/.
*.log

# Test / lint caches
.pytest_cache/
.ruff_cache/

# Per-machine agent permissions, not a repository policy.
.claude/settings.local.json
